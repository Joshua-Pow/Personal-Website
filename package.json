{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-adages-manifest.mjs && vite dev",
    "build": "node scripts/generate-adages-manifest.mjs && vite build",
    "preview": "node scripts/generate-adages-manifest.mjs && vite preview",
    "start": "vite preview",
    "lint": "node scripts/generate-adages-manifest.mjs && ultracite check && tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "husky",
    "deploy": "node scripts/sync-adage-images.mjs && npm run build && wrangler deploy",
    "upload": "node scripts/sync-adage-images.mjs && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "adages:upload": "node scripts/upload-adage-image.mjs",
    "spotify:refresh-token": "node scripts/get-spotify-refresh-token.mjs",
    "check": "ultracite check"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.58",
    "@types/iso-3166-2": "^1.0.3",
    "clsx": "^2.1.1",
    "cobe": "^0.6.3",
    "iso-3166-2": "^1.0.0",
    "motion": "^12.42.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "ultracite": "^7.12.0",
    "vite": "^8.3.1",
    "wrangler": "^4.59.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
